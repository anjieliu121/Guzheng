  "evaluation": {
    "OA_pitch_class": 0.918,
    "OA_duration": 0.839,
    "pentatonic_purity": 1.0,
    "note_density": 3.45
  },
  "recommendation": "MIDI-RWKV state-tuned with post-processing is the best pipeline. Generate unconstrained, then post-process to snap pitches and constrain range."
}
