{
  "model": "MIDI-RWKV (RWKV-7, 36M params, 12 layers, 384 embd)",
  "peft": "state-tuning",
  "peft_checkpoint": "archive/midi-rwkv/RWKV-PEFT/peft_model_guzheng/",
  "base_model": "archive/midi-rwkv/midi_rwkv.pth",
  "tokenizer": "archive/midi-rwkv/train/tokenizer/tokenizer.json",
  "generation": {
    "temperature": 0.85,
    "top_p": 0.9,
    "max_new_tokens": 512,
    "prompt_tokens": 64,
    "constrained": false,
    "seed": 42
